{
  "functions": {
    "api/analizar.js": {
      "maxDuration": 120
    },
    "api/recruiter.js": {
      "maxDuration": 180
    },
    "api/cv-check.js": {
      "maxDuration": 60
    },
    "api/profile.js": {
      "maxDuration": 60
    },
    "api/relato.js": {
      "maxDuration": 90
    },
    "api/career.js": {
      "maxDuration": 300
    },
    "api/entrevistas/index.js": {
      "maxDuration": 30
    },
    "api/keepalive.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/leer-oferta",
      "destination": "/api/keepalive"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "missing": [
        {
          "type": "query",
          "key": "oferta"
        }
      ],
      "destination": "/empleos",
      "permanent": false
    },
    {
      "source": "/index.html",
      "missing": [
        {
          "type": "query",
          "key": "oferta"
        }
      ],
      "destination": "/empleos",
      "permanent": false
    },
    {
      "source": "/match-planes",
      "destination": "/empleos",
      "permanent": false
    },
    {
      "source": "/match-planes.html",
      "destination": "/empleos",
      "permanent": false
    },
    {
      "source": "/sueldo",
      "destination": "/empleos",
      "permanent": false
    },
    {
      "source": "/sueldo.html",
      "destination": "/empleos",
      "permanent": false
    },
    {
      "source": "/relato",
      "destination": "/empleos",
      "permanent": false
